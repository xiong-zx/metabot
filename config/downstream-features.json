{
  "schemaVersion": 1,
  "upstream": {
    "remote": "upstream",
    "repository": "https://github.com/xvirobotics/metabot.git",
    "branch": "main"
  },
  "features": [
    {
      "id": "lark-domain",
      "status": "required",
      "roots": ["src/feishu/domain.ts", "src/feishu/client-factory.ts"]
    },
    {
      "id": "metamemory-index-automation",
      "status": "required",
      "roots": [
        "src/memory/index-automation.ts",
        "packages/server/src/memory/index-reconciliation.ts",
        "packages/server/src/memory/routing-index.ts"
      ]
    },
    {
      "id": "wiki-change-feed-adapter",
      "status": "required",
      "roots": ["src/sync/wiki-auto-sync.ts", "src/sync/wiki-sync-runtime.ts"],
      "forbiddenImports": [
        "src/api",
        "src/bridge",
        "src/agent-teams",
        "src/restart",
        "@xvirobotics/arc-mcp",
        "@xvirobotics/worker-runner-mcp",
        "@xvirobotics/arc-worker-runner-adapter",
        "@xvirobotics/arc-researchclaw-adapter"
      ],
      "reason": "Consume durable MetaMemory changes while keeping Wiki target selection and runtime wiring isolated from unrelated downstream services.",
      "validationSurface": [
        "tests/doc-sync.test.ts",
        "tests/sync-store.test.ts",
        "tests/wiki-auto-sync.test.ts",
        "tests/wiki-sync-runtime.test.ts"
      ]
    },
    {
      "id": "agent-team-governance",
      "status": "required",
      "roots": [
        "src/agent-teams/governance-extension.ts",
        "src/agent-teams/governance-capability.ts",
        "src/agent-teams/schedule-capability.ts"
      ],
      "forbiddenImports": [
        "src/memory-core",
        "src/workers",
        "@xvirobotics/arc-mcp",
        "@xvirobotics/worker-runner-mcp"
      ],
      "reason": "Keep signed engine capabilities and least-privilege Agent Team governance as an isolated downstream extension.",
      "validationSurface": [
        "tests/agent-team-governance-capability.test.ts",
        "tests/agent-team-schedule-capability.test.ts",
        "tests/agent-team-http-auth.test.ts",
        "tests/agent-team-cli-capability.test.ts",
        "tests/downstream-boundaries.test.ts"
      ]
    },
    {
      "id": "agent-team-compact-card-upstream-gap",
      "status": "required",
      "roots": ["src/feishu/team-panel.ts"],
      "forbiddenImports": [
        "src/memory-core",
        "src/workers",
        "@xvirobotics/worker-runner-mcp"
      ],
      "reason": "Track the generic compact Agent Team card renderer as a removable upstreamable patch until upstream accepts it.",
      "validationSurface": [
        "tests/card-builder.test.ts",
        "tests/card-builder-v2.test.ts",
        "tests/feishu-event-handler.test.ts"
      ]
    },
    {
      "id": "agent-team-busy-chat-reliability-upstream-gap",
      "status": "required",
      "roots": [
        "src/scheduler/busy-retry-policy.ts",
        "src/bridge/deferred-activity-delivery.ts"
      ],
      "forbiddenImports": [
        "src/memory-core",
        "src/workers",
        "@xvirobotics/worker-runner-mcp"
      ],
      "reason": "Track generic bounded busy-chat retry, burst coalescing, and reusable activity-card delivery as removable upstreamable patches until upstream accepts them.",
      "validationSurface": [
        "tests/busy-retry-policy.test.ts",
        "tests/task-scheduler-one-time.test.ts",
        "tests/deferred-activity-delivery.test.ts",
        "tests/message-bridge.test.ts"
      ]
    },
    {
      "id": "terminal-callback-inbox",
      "status": "required",
      "roots": [
        "src/services/terminal-event-store.ts",
        "src/api/routes/worker-events-routes.ts",
        "src/api/http-server.ts"
      ],
      "forbiddenImports": [
        "src/memory-core",
        "@xvirobotics/arc-mcp",
        "@xvirobotics/worker-runner-mcp",
        "@xvirobotics/arc-worker-runner-adapter",
        "@xvirobotics/arc-researchclaw-adapter"
      ],
      "reason": "Durably deliver detached Worker and ARC terminal metadata to the authorized chat without coupling upstream core to either runner package.",
      "validationSurface": [
        "tests/terminal-event-store.test.ts",
        "tests/worker-events-route.test.ts",
        "tests/downstream-boundaries.test.ts"
      ]
    },
    {
      "id": "arc-mcp",
      "status": "required",
      "roots": ["packages/arc-mcp"],
      "forbiddenImports": [
        "src/memory-core",
        "src/mcp/worker-manager",
        "src/workers",
        "src/api/routes/research-memory",
        "src/engines",
        "src/bridge",
        "@xvirobotics/worker-runner-mcp"
      ],
      "reason": "Keep the AutoResearchClaw lifecycle, contract, durable state, and local daemon independently testable outside the upstream Bridge runtime.",
      "validationSurface": [
        "packages/arc-mcp/tests/contract.test.ts",
        "packages/arc-mcp/tests/lifecycle.test.ts",
        "packages/arc-mcp/tests/daemon-auth.test.ts",
        "packages/arc-mcp/tests/recovery-races.test.ts"
      ]
    },
    {
      "id": "worker-runner-mcp",
      "status": "required",
      "roots": ["packages/worker-runner-mcp"],
      "forbiddenImports": [
        "src/memory-core",
        "src/workers",
        "src/agent-teams/team-store",
        "src/bridge",
        "@xvirobotics/arc-mcp"
      ],
      "reason": "Keep durable one-shot Worker execution and callback delivery isolated behind an authenticated local MCP boundary.",
      "validationSurface": [
        "packages/worker-runner-mcp/tests/mcp-integration.test.ts",
        "packages/worker-runner-mcp/tests/service.test.ts",
        "packages/worker-runner-mcp/tests/notifier.test.ts"
      ]
    },
    {
      "id": "arc-researchclaw-adapter",
      "status": "required",
      "roots": ["packages/arc-researchclaw-adapter"],
      "importRoots": ["packages/arc-researchclaw-adapter/src"],
      "forbiddenImports": [
        "src/memory-core",
        "src/agent-teams",
        "src/bridge",
        "src/engines",
        "@xvirobotics/worker-runner-mcp"
      ],
      "reason": "Delegate execution and HITL controls to a pinned external official AutoResearchClaw checkout without importing Bridge, Worker Runner, or MetaMemory internals.",
      "validationSurface": [
        "packages/arc-researchclaw-adapter/tests/adapter.test.ts",
        "packages/arc-researchclaw-adapter/tests/hitl.test.ts",
        "packages/arc-researchclaw-adapter/tests/boundary.test.ts"
      ]
    },
    {
      "id": "arc-worker-runner-adapter",
      "status": "required",
      "roots": ["packages/arc-worker-runner-adapter"],
      "importRoots": ["packages/arc-worker-runner-adapter/src"],
      "forbiddenImports": [
        "src/memory-core",
        "src/agent-teams",
        "src/bridge",
        "src/engines",
        "better-sqlite3",
        "@xvirobotics/worker-runner-mcp"
      ],
      "reason": "Adapt ARC to Worker Runner only through the public MCP wire without importing either daemon implementation.",
      "validationSurface": [
        "packages/arc-worker-runner-adapter/tests/adapter.test.ts",
        "packages/arc-worker-runner-adapter/tests/integration.test.ts",
        "packages/arc-worker-runner-adapter/tests/boundary.test.ts"
      ]
    },
    {
      "id": "ci-runtime-prerequisites",
      "status": "required",
      "roots": [
        ".github/workflows/ci.yml",
        "tests/ci-workflow.test.ts"
      ],
      "reason": "Build retained downstream runtime packages before root tests exercise the production restart artifact preflight.",
      "validationSurface": [
        "tests/ci-workflow.test.ts",
        "tests/metabot-controlled-restart-cli.test.ts",
        "tests/downstream-boundaries.test.ts"
      ]
    }
  ],
  "reverseBoundaries": [
    {
      "id": "upstream-runtime-isolation",
      "roots": ["src"],
      "forbiddenImports": [
        "@xvirobotics/arc-mcp",
        "@xvirobotics/worker-runner-mcp",
        "@xvirobotics/arc-worker-runner-adapter",
        "@xvirobotics/arc-researchclaw-adapter"
      ]
    }
  ],
  "forbiddenPaths": [
    "src/memory-core",
    "src/api/routes/research-memory-routes.ts",
    "src/mcp/worker-manager-mcp.ts",
    "src/workers/worker-manager.ts",
    "src/engines/home-instructions.ts",
    "src/workspace",
    "web"
  ]
}
