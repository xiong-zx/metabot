{
  "schemaVersion": 1,
  "upstream": {
    "remote": "upstream",
    "repository": "https://github.com/xvirobotics/metabot.git",
    "branch": "main"
  },
  "features": [
    {
      "id": "lark-domain",
      "status": "required",
      "roots": ["src/feishu/domain.ts", "src/feishu/client-factory.ts"]
    },
    {
      "id": "metabot-todos",
      "status": "required",
      "roots": ["packages/skills/metabot-todos"]
    },
    {
      "id": "metamemory-index-automation",
      "status": "required",
      "roots": [
        "src/memory/index-automation.ts",
        "packages/server/src/memory/index-reconciliation.ts",
        "packages/server/src/memory/routing-index.ts"
      ]
    },
    {
      "id": "agent-team-governance",
      "status": "required",
      "roots": [
        "src/agent-teams/governance-extension.ts",
        "src/agent-teams/governance-capability.ts",
        "src/agent-teams/schedule-capability.ts"
      ],
      "forbiddenImports": [
        "src/memory-core",
        "src/workers",
        "@xvirobotics/worker-runner-mcp"
      ],
      "reason": "Keep signed engine capabilities and least-privilege Agent Team governance as an isolated downstream extension.",
      "validationSurface": [
        "tests/agent-team-governance-capability.test.ts",
        "tests/agent-team-schedule-capability.test.ts",
        "tests/agent-team-http-auth.test.ts",
        "tests/agent-team-cli-capability.test.ts",
        "tests/downstream-boundaries.test.ts"
      ]
    },
    {
      "id": "agent-team-compact-card-upstream-gap",
      "status": "required",
      "roots": ["src/feishu/team-panel.ts"],
      "forbiddenImports": [
        "src/memory-core",
        "src/workers",
        "@xvirobotics/worker-runner-mcp"
      ],
      "reason": "Track the generic compact Agent Team card renderer as a removable upstreamable patch until upstream accepts it.",
      "validationSurface": [
        "tests/card-builder.test.ts",
        "tests/card-builder-v2.test.ts",
        "tests/feishu-event-handler.test.ts"
      ]
    },
    {
      "id": "agent-team-busy-chat-reliability-upstream-gap",
      "status": "required",
      "roots": [
        "src/scheduler/busy-retry-policy.ts",
        "src/bridge/deferred-activity-delivery.ts"
      ],
      "forbiddenImports": [
        "src/memory-core",
        "src/workers",
        "@xvirobotics/worker-runner-mcp"
      ],
      "reason": "Track generic bounded busy-chat retry and activity delivery as removable upstreamable patches until upstream accepts them.",
      "validationSurface": [
        "tests/busy-retry-policy.test.ts",
        "tests/task-scheduler-one-time.test.ts",
        "tests/deferred-activity-delivery.test.ts",
        "tests/message-bridge.test.ts"
      ]
    },
    {
      "id": "arc-mcp",
      "status": "required",
      "roots": ["packages/arc-mcp"],
      "forbiddenImports": [
        "src/memory-core",
        "src/mcp/worker-manager",
        "src/workers",
        "src/api/routes/research-memory",
        "src/engines",
        "src/bridge",
        "@xvirobotics/worker-runner-mcp"
      ]
    },
    {
      "id": "worker-runner-mcp",
      "status": "required",
      "roots": ["packages/worker-runner-mcp"],
      "forbiddenImports": [
        "src/memory-core",
        "src/workers",
        "src/agent-teams/team-store",
        "src/bridge",
        "@xvirobotics/arc-mcp"
      ]
    },
    {
      "id": "arc-worker-runner-adapter",
      "status": "required",
      "roots": ["packages/arc-worker-runner-adapter"],
      "importRoots": ["packages/arc-worker-runner-adapter/src"],
      "forbiddenImports": [
        "src/memory-core",
        "src/agent-teams",
        "src/bridge",
        "src/engines",
        "better-sqlite3",
        "@xvirobotics/worker-runner-mcp"
      ]
    }
  ],
  "reverseBoundaries": [
    {
      "id": "upstream-runtime-isolation",
      "roots": ["src"],
      "forbiddenImports": [
        "@xvirobotics/arc-mcp",
        "@xvirobotics/worker-runner-mcp",
        "@xvirobotics/arc-worker-runner-adapter"
      ]
    }
  ],
  "forbiddenPaths": [
    "src/memory-core",
    "src/api/routes/research-memory-routes.ts",
    "src/mcp/worker-manager-mcp.ts",
    "src/workers/worker-manager.ts",
    "src/engines/home-instructions.ts",
    "src/workspace",
    "web"
  ]
}
