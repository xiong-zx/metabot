      "id": "user.latex-report-pdf-default",
      "version": "1.0.0",
      "text": "When the user asks for a report written in LaTeX, compile it and return the PDF by default, not the TeX source file. Return the TeX source file only when the user explicitly asks for it.",
      "scope": "global",
      "targets": {},
      "authority": "user-approved",
      "priority": 360,
      "overridable": false,
      "mandatory": true,
      "lifecycle": { "status": "approved" },
      "source": {
