{
  "rulesPackDefaults": {
    "policy": "required",
    "config": {
      "mode": "shadow",
      "hostId": "local",
      "dbPath": "/home/user/.metabot/rulespack/{surface}-{bot}.sqlite",
      "metaMemory": {
        "id": "local-codex-policy",
        "hostRoot": "/local",
        "paths": ["/local/rules/codex/metabot-development"],
        "required": true,
        "freshForMs": 300000
      },
      "projectBindings": [
        { "projectId": "metabot", "root": "/home/user/metabot" },
        { "projectId": "metabot", "root": "/home/user/metabot-worktrees" },
        { "projectId": "project-alpha", "root": "/home/user/project-alpha" }
      ],
      "projectChatBindings": [
        {
          "projectId": "project-alpha",
          "chats": [
            { "bot": "project-alpha", "chatId": "oc_project_alpha_primary" },
            { "bot": "tg-project", "chatId": "tg_project_alpha_updates" }
          ]
        }
      ],
      "dispatch": {
        "issuer": "metabot-core-admin",
        "audience": "metabot-host:local",
        "allowedIssuers": ["metabot-core-admin"],
        "maxEnvelopeTtlMs": 900000
      }
    }
  },
  "feishuBots": [
    {
      "name": "project-alpha",
      "description": "Frontend development agent for Project Alpha — React, TypeScript, CSS",
      "specialties": ["frontend", "react", "typescript", "css"],
      "icon": "🎨",
      "maxConcurrentTasks": 3,
      "budgetLimitDaily": 5.0,
      "ttsVoice": "zh_male_rap_mars_bigtts",
      "feishuAppId": "cli_xxx",
      "feishuAppSecret": "secret1",
      "defaultWorkingDirectory": "/home/user/project-alpha",
      "artifactDelivery": {
        "mode": "enforce",
        "projects": [
          {
            "projectId": "project-alpha",
            "root": "/home/user/project-alpha",
            "chatIds": ["oc_project_alpha_primary"]
          }
        ]
      }
    },
    {
      "name": "project-beta",
      "description": "Backend API development agent for Project Beta",
      "specialties": ["backend", "api", "database"],
      "feishuAppId": "cli_yyy",
      "feishuAppSecret": "secret2",
      "feishuDomain": "lark",
      "defaultWorkingDirectory": "/home/user/project-beta",
      "maxTurns": 30,
      "maxBudgetUsd": 0.5
    },
    {
      "name": "project-gamma",
      "description": "Kimi-powered agent (uses your Moonshot subscription)",
      "engine": "kimi",
      "feishuAppId": "cli_zzz",
      "feishuAppSecret": "secret3",
      "defaultWorkingDirectory": "/home/user/project-gamma",
      "kimi": {
        "model": "kimi-latest",
        "thinking": true
      }
    },
    {
      "name": "project-delta",
      "description": "Codex-powered agent (uses Codex CLI)",
      "engine": "codex",
      "feishuAppId": "cli_codex",
      "feishuAppSecret": "secret4",
      "defaultWorkingDirectory": "/home/user/project-delta",
      "codex": {
        "model": "gpt-5.5",
        "apiKey": "sk-optional-openai-compatible-key",
        "baseUrl": "https://api.openai.com/v1",
        "approvalPolicy": "never",
        "sandbox": "workspace-write"
      }
    }
  ],
  "telegramBots": [
    {
      "name": "tg-project",
      "description": "General purpose project assistant via Telegram",
      "telegramBotToken": "123456:ABC-DEF...",
      "defaultWorkingDirectory": "/home/user/project"
    }
  ],
  "wechatBots": [
    {
      "name": "wechat-assistant",
      "description": "WeChat AI assistant via iLink",
      "defaultWorkingDirectory": "/home/user/project"
    }
  ],
  "slackBots": [
    {
      "name": "slack-codex",
      "description": "Codex-powered assistant via Slack DM or @mention",
      "engine": "codex",
      "slackBotToken": "xoxb-...",
      "slackSigningSecret": "slack-signing-secret",
      "defaultWorkingDirectory": "/home/user/project",
      "codex": {
        "approvalPolicy": "never",
        "sandbox": "workspace-write"
      }
    }
  ],
  "peers": [
    {
      "name": "alice",
      "url": "http://localhost:9200",
      "auth": {
        "keyId": "local-alice-v1",
        "secret": "<peer-scoped-secret-at-least-32-characters>",
        "sourceBot": "local-bot",
        "allowedSourceBots": ["alice-bot", "bridge:alice"],
        "allowedTargetBots": ["local-bot"]
      }
    },
    {
      "name": "remote-team",
      "url": "http://remote-server:9100",
      "auth": {
        "keyId": "local-remote-team-v1",
        "secret": "<peer-scoped-secret-at-least-32-characters>"
      }
    }
  ]
}
