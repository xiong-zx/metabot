{
  "name": "@metabot/rulespack",
  "version": "0.1.0",
  "description": "Standalone deterministic RulesPack engine for Codex and Claude integrations",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "rulespack": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "VENDORED_FROM.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:focused": "node --import tsx --test",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "tsx": "4.22.3",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
