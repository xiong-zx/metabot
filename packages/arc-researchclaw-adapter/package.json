{
  "name": "@xvirobotics/arc-researchclaw-adapter",
  "version": "0.1.0",
  "description": "Isolated MetaBot runner adapter for the official AutoResearchClaw pipeline and HITL MCP",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "metabot-arc-official": "dist/install-cli.js"
  },
  "files": [
    "dist",
    "python",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/"
  },
  "dependencies": {
    "@xvirobotics/arc-mcp": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
