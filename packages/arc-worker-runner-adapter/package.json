{
  "name": "@xvirobotics/arc-worker-runner-adapter",
  "version": "0.1.0",
  "description": "Independent AutoResearchClaw runner adapter for the Worker Runner MCP wire",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xvirobotics/arc-mcp": "*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@xvirobotics/worker-runner-mcp": "*",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
